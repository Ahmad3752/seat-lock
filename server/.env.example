# Copy this file to .env and replace the example secrets. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27018/seatlock?replicaSet=rs0&directConnection=true
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
HOLD_DURATION_MINUTES=10
MAX_SEATS_PER_HOLD=8
HOLD_EXPIRY_WORKER_INTERVAL_MS=30000
